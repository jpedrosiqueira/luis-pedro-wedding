---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { langPaths, type Lang, useT, rich } from '../../i18n';
import { site } from '../../config/site';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const g = t.gifts;
---
<Layout lang={lang} pageKey="gifts" slug="gifts" title={g.title} description={g.lead}>
  <PageHero lang={lang} pageKey="gifts" title={g.title} lead={g.lead} photo="gifts" />
  <section class="section">
    <div class="wrap split">
      <div class="split__head"><h2>{g.fund.title}</h2></div>
      <div class="stack">
        <p class="prose" style="font-size: var(--text-lg)" set:html={rich(lang, g.text)} />
        {site.registryUrl
          ? <p><a class="btn" href={site.registryUrl} target="_blank" rel="noopener">{g.fund.cta}</a></p>
          : <p class="callout" set:html={rich(lang, g.fund.text)} />}
      </div>
    </div>
  </section>
</Layout>
