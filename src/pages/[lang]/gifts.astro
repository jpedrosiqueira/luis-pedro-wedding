---
import Layout from '../../layouts/Layout.astro';
import Banner from '../../components/Banner.astro';
import Intro from '../../components/Intro.astro';
import { langPaths, type Lang, useT, rich } from '../../i18n';
import { site } from '../../config/site';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const g = t.gifts;
---
<Layout lang={lang} pageKey="gifts" slug="gifts" title={g.title} description={g.lead}>
  <Banner lang={lang} title={g.title} photo="gifts" />
  <Intro lang={lang} lead={g.lead} ornament="marigold">
    <p class="muted" style="max-width: 34rem; margin: var(--space-6) auto 0" set:html={rich(lang, g.text)} />
  </Intro>
  <section class="section section--flush">
    <div class="wrap center" style="max-width: 46rem">
      <h2>{g.fund.title}</h2>
      <div style="margin-top: var(--space-6)">
        {site.registryUrl
          ? <a class="btn" href={site.registryUrl} target="_blank" rel="noopener">{g.fund.cta}</a>
          : <p class="callout" style="text-align: left" set:html={rich(lang, g.fund.text)} />}
      </div>
    </div>
  </section>
</Layout>
