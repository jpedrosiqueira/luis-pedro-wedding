---
import Layout from '../../layouts/Layout.astro';
import Banner from '../../components/Banner.astro';
import Intro from '../../components/Intro.astro';
import Photo from '../../components/Photo.astro';
import { langPaths, type Lang, useT, rich, plain } from '../../i18n';
import { site } from '../../config/site';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const s = t.story;
---
<Layout lang={lang} pageKey="story" slug="story" title={s.title} description={s.lead}>
  <Banner lang={lang} title={s.title} photo="story" />
  <Intro lang={lang} lead={s.lead} />
  <section class="section section--flush">
    <div class="wrap">
      <div class="prose" style="margin-inline: auto">
        {s.paragraphs.map((p) => <p set:html={rich(lang, p)} />)}
        <p class="signature"><small>{t.common.withLove}</small>{site.couple.a} &amp; {site.couple.b}</p>
      </div>
    </div>
  </section>
  <section class="section rule">
    <div class="wrap">
      <div class="section-head"><h2>{s.galleryTitle}</h2></div>
      <div class="gallery">
        {s.gallery.map((alt, i) => <Photo name={`story-${i + 1}`} alt={plain(lang, alt)} lang={lang} framed ratio={i % 3 === 1 ? '3 / 4' : '4 / 5'} sizes="(min-width: 56rem) 30vw, 46vw" />)}
      </div>
    </div>
  </section>
</Layout>
