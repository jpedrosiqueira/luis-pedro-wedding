---
import Layout from '../../layouts/Layout.astro';
import Banner from '../../components/Banner.astro';
import Intro from '../../components/Intro.astro';
import Feature from '../../components/Feature.astro';
import { langPaths, type Lang, useT, rich } from '../../i18n';
import { site } from '../../config/site';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const v = t.venue;
const q = encodeURIComponent(site.venue.mapQuery);
---
<Layout lang={lang} pageKey="venue" slug="venue" title={v.title} description={v.lead}>
  <Banner lang={lang} title={v.title} photo="venue" />
  <Intro lang={lang} lead={v.lead} ornament="arch" />
  <section class="section section--flush">
    <div class="wrap">
      <Feature lang={lang} photo="venue-courtyard" title={v.about.title} text={v.about.paragraphs} ornament="arch" />
      <Feature lang={lang} photo="venue-village" title={v.village.title} text={v.village.paragraphs} ornament="lantern" flip />
    </div>
  </section>
  <section class="section rule">
    <div class="wrap split">
      <div class="split__head"><h2>{v.expect.title}</h2></div>
      <ul class="rows">
        {v.expect.items.map((it) => <li><h3>{it.title}</h3><p set:html={rich(lang, it.text)} /></li>)}
      </ul>
    </div>
  </section>
  <section class="section rule">
    <div class="wrap split">
      <div class="split__head">
        <h2>{v.map.title}</h2>
        <p class="muted"><span translate="no">{v.map.address}</span></p>
        <p class="small" set:html={rich(lang, v.map.note)} />
        <p><a class="text-link" href={`https://www.google.com/maps/search/?api=1&query=${q}`} target="_blank" rel="noopener">{t.common.openMaps}</a></p>
      </div>
      <iframe class="map" title={v.map.iframeTitle} loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={`https://www.google.com/maps?q=${q}&z=14&hl=${lang}&output=embed`}></iframe>
    </div>
  </section>
</Layout>
