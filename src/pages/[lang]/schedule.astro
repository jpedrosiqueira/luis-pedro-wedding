---
import Layout from '../../layouts/Layout.astro';
import Banner from '../../components/Banner.astro';
import Intro from '../../components/Intro.astro';
import { langPaths, type Lang, useT, rich, fmtTime, fmtDate } from '../../i18n';
import { days, events } from '../../data/schedule';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const s = t.schedule;
const ev = s.events as Record<string, { title: string; desc: string; place: string }>;
---
<Layout lang={lang} pageKey="schedule" slug="schedule" title={s.title} description={s.lead}>
  <Banner lang={lang} title={s.title} photo="schedule" />
  <Intro lang={lang} lead={s.lead} ornament="lantern" />
  {days.map((d) => (
    <section class:list={['day', d.id === 'sat' ? 'day--main' : 'rule']}>
      <div class="wrap">
        <header class="day__head">
          <span class="day__num numeral" aria-hidden="true">{d.date.slice(8)}</span>
          <h2><time datetime={d.date}>{fmtDate(lang, d.date, { year: undefined })}</time></h2>
        </header>
        <ol class="timeline">
          {events.filter((e) => e.day === d.id).map((e) => (
            <li>
              <p class="timeline__time">
                {e.time ? <time datetime={`${d.date}T${e.time}`}>{fmtTime(lang, e.time)}</time> : <Fragment set:html={rich(lang, s.timePending)} />}
              </p>
              <div class="timeline__body">
                <h3>{ev[e.id].title}{e.tentative && <span class="tag">{t.common.tbc}</span>}</h3>
                <p set:html={rich(lang, ev[e.id].desc)} />
                <p class="timeline__place" set:html={rich(lang, ev[e.id].place)} />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  ))}
</Layout>
