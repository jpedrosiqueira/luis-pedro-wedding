---
import Layout from '../../layouts/Layout.astro';
import Banner from '../../components/Banner.astro';
import Intro from '../../components/Intro.astro';
import { langPaths, type Lang, useT, rich } from '../../i18n';
import { site } from '../../config/site';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const f = t.faq;
const c = f.contact;
---
<Layout lang={lang} pageKey="faq" slug="faq" title={f.title} description={f.lead}>
  <Banner lang={lang} title={f.title} photo="faq" />
  <Intro lang={lang} lead={f.lead} />
  <section class="section section--flush">
    <div class="wrap">
      <div class="faq">
        {f.items.map((it) => (
          <details>
            <summary>{it.q}</summary>
            <div><p set:html={rich(lang, it.a)} /></div>
          </details>
        ))}
      </div>
    </div>
  </section>
  <section class="section rule" id="contact">
    <div class="wrap split">
      <div class="split__head"><h2>{c.title}</h2></div>
      <div>
        <p class="prose">{c.text}</p>
        <div class="contact-links">
          {site.contact.email
            ? <a class="btn" href={`mailto:${site.contact.email}`}>{c.email}</a>
            : <span set:html={rich(lang, c.emailTodo)} />}
          {site.contact.whatsapp
            ? <a class="btn btn--outline" href={`https://wa.me/${site.contact.whatsapp}`} target="_blank" rel="noopener">{c.whatsapp}</a>
            : <span set:html={rich(lang, c.whatsappTodo)} />}
        </div>
        <p class="muted" style="margin-top: var(--space-6)" set:html={rich(lang, c.dayOf)} />
      </div>
    </div>
  </section>
</Layout>
