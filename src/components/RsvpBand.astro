---
import { href, type Lang, useT } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
---
<section class="band">
  <div class="wrap" data-reveal>
    <h2>{t.home.rsvpBand.title}</h2>
    <p>{t.home.rsvpBand.text}</p>
    <a class="btn btn--light" href={href(lang, 'rsvp')}>{t.common.rsvp}</a>
  </div>
</section>
