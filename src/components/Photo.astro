---
/**
 * Shows src/assets/photos/<name>.(jpg|jpeg|png|webp|avif) if that file exists,
 * resized and compressed automatically. If it does not exist yet, shows a
 * placeholder with the file name to add. See README, "Replacing photos".
 */
import { Image } from 'astro:assets';
import type { Lang } from '../i18n';
import { useT } from '../i18n';

interface Props { name: string; alt: string; lang: Lang; ratio?: string; arch?: boolean; eager?: boolean; sizes?: string; class?: string; }
const { name, alt, lang, ratio = '4 / 5', arch = false, eager = false, sizes = '(min-width: 56rem) 40vw, 92vw', class: cls = '' } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG}', { eager: true });
const hit = Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.[^.]+$/, '') === name);
const t = useT(lang);
const cleanAlt = alt.replace(/\[TODO:?\s*([^\]]*)\]/g, '').trim();
---
{hit ? (
  <div class:list={['photo', arch && 'photo--arch', cls]} style={`--ratio: ${ratio}`}>
    <Image
      src={hit[1].default}
      alt={cleanAlt}
      widths={[480, 800, 1200, 1600]}
      sizes={sizes}
      quality={72}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding={eager ? 'sync' : 'async'}
    />
  </div>
) : (
  <div class:list={['photo', 'photo--empty', arch && 'photo--arch', cls]} style={`--ratio: ${ratio}`} role="img" aria-label={`${t.common.photoTodo}: ${name}`}>
    <div>
      <svg viewBox="0 0 80 100" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
        <path d="M8 98V42a32 32 0 0 1 64 0v56" />
        <path d="M18 98V44a22 22 0 0 1 44 0v54" />
        <path d="M2 98h76" />
      </svg>
      <p class="photo__note"><b>{t.common.photoTodo}</b><code>{name}.jpg</code></p>
    </div>
  </div>
)}
