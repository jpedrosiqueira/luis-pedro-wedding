---
import { pages, href, type Lang, useT, fill } from '../i18n';
import { site } from '../config/site';
import Seal from './Seal.astro';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const nav = t.nav as Record<string, string>;
---
<footer class="footer">
  <div class="wrap">
    <Seal />
    <p class="footer__names">{site.couple.a} <span>&amp;</span> {site.couple.b}</p>
    <nav aria-label={nav.main}>
      <ul class="footer__nav">
        {pages.map((p) => <li><a href={href(lang, p.slug)}>{nav[p.key]}</a></li>)}
        <li><a href={href(lang, 'rsvp')}>{nav.rsvp}</a></li>
      </ul>
    </nav>
    <p class="footer__base">{fill(lang, t.footer.place)}</p>
  </div>
</footer>
