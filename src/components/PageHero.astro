---
import type { Lang } from '../i18n';
import { rich, pages } from '../i18n';
import Photo from './Photo.astro';
interface Props { lang: Lang; pageKey: string; title: string; lead: string; photo?: string; photoAlt?: string; }
const { lang, pageKey, title, lead, photo, photoAlt = '' } = Astro.props;
const n = pages.findIndex((p) => p.key === pageKey) + 1;
---
<section class="page-hero">
  <div class:list={['wrap', photo && 'page-hero__grid']}>
    <div>
      {n > 0 && <span class="label page-hero__num" aria-hidden="true">{String(n).padStart(2, '0')}</span>}
      <h1>{title}</h1>
      <p class="page-hero__lead" set:html={rich(lang, lead)} />
    </div>
    {photo && <Photo name={photo} alt={photoAlt || title} lang={lang} arch eager ratio="4 / 5" sizes="(min-width: 56rem) 30vw, 22rem" />}
  </div>
</section>
