---
import { pages, href, type Lang, useT } from '../i18n';
import { site } from '../config/site';
import LangSwitcher from './LangSwitcher.astro';
const { lang, pageKey, slug = '' } = Astro.props as { lang: Lang; pageKey: string; slug?: string };
const t = useT(lang);
const nav = t.nav as Record<string, string>;
---
<header class="site-header on-photo" data-header>
  <div class="wrap site-header__top">
    <a class="wordmark" href={href(lang)}>
      <span class="wordmark__short" aria-hidden="true">{site.couple.a[0]}<span class="amp">&amp;</span>{site.couple.b[0]}</span>
      <span class="wordmark__full" aria-hidden="true">{site.couple.a} <span class="amp">&amp;</span> {site.couple.b}</span>
      <span class="visually-hidden">{site.couple.a} &amp; {site.couple.b}: {nav.home}</span>
    </a>
    <LangSwitcher lang={lang} slug={slug} />
    <a class="btn btn--small site-header__rsvp" href={href(lang, 'rsvp')}>{nav.rsvp}</a>
    <details class="menu">
      <summary><span>{nav.menu}</span><span class="menu__icon" aria-hidden="true"></span></summary>
      <nav class="menu__panel" aria-label={nav.main}>
        <ul>
          <li><a href={href(lang)} aria-current={pageKey === 'home' ? 'page' : undefined}>{nav.home}</a></li>
          {pages.map((p) => (
            <li><a href={href(lang, p.slug)} aria-current={pageKey === p.key ? 'page' : undefined}>{nav[p.key]}</a></li>
          ))}
        </ul>
        <a class="btn" href={href(lang, 'rsvp')}>{nav.rsvp}</a>
      </nav>
    </details>
  </div>
  <nav class="site-header__nav" aria-label={nav.main}>
    <ul class="wrap">
      {pages.map((p) => (
        <li><a href={href(lang, p.slug)} aria-current={pageKey === p.key ? 'page' : undefined}>{nav[p.key]}</a></li>
      ))}
    </ul>
  </nav>
</header>
